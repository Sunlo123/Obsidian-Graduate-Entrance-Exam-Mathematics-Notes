{
	"nodes":[
		{"id":"cd644dc9298ad930","type":"group","x":0,"y":80,"width":1500,"height":1820,"label":"向量组的线性关系","color":"5"},
		{"id":"2c0a6f0153e08291","type":"group","x":1680,"y":80,"width":1500,"height":1820,"label":"矩阵的秩与线性表示","color":"6"},
		{"id":"c210d67c14c2e723","type":"group","x":3360,"y":80,"width":1500,"height":1820,"label":"线性方程组的解","color":"4"},
		{"id":"2c19420546fb99b3","type":"group","x":0,"y":2100,"width":1500,"height":1380,"label":"向量组等价、矩阵等价与初等变换","color":"3"},
		{"id":"f6044a81fe3dd5a9","type":"group","x":1680,"y":2100,"width":1500,"height":900,"label":"方阵、行列式与可逆","color":"2"},
		{"id":"03cca0ad1dbc3308","type":"group","x":3360,"y":2100,"width":1500,"height":1580,"label":"特征值、相似与二次型","color":"1"},
		{"id":"d77851a6184f3ec3","type":"text","x":80,"y":210,"width":565,"height":120,"text":"**列向量组线性无关**","color":"5"},
		{"id":"6ef44bd0697acba7","type":"text","x":860,"y":210,"width":565,"height":120,"text":"**列向量组线性相关**","color":"5"},
		{"id":"b282d6ca85f91e3f","type":"text","x":80,"y":430,"width":565,"height":120,"text":"任一向量都不能由其余向量线性表示"},
		{"id":"5a7711e85f731797","type":"text","x":860,"y":430,"width":565,"height":120,"text":"至少一个向量可由其余向量线性表示"},
		{"id":"a63a051de5e8fc23","type":"text","x":80,"y":650,"width":565,"height":120,"text":"任一部分向量组仍线性无关"},
		{"id":"18fe51890c70148a","type":"text","x":860,"y":650,"width":565,"height":120,"text":"含零向量或存在成比例的两个向量 ⇒ 线性相关"},
		{"id":"3f3fc80af1c0cb21","type":"text","x":80,"y":870,"width":565,"height":120,"text":"给每个向量同位添加分量后，仍线性无关"},
		{"id":"7c034b0b932e31b1","type":"text","x":860,"y":870,"width":565,"height":120,"text":"增加向量后，仍线性相关"},
		{"id":"f76c89722dab7840","type":"text","x":80,"y":1090,"width":565,"height":120,"text":"线性相关性的常用判别（七大定理）"},
		{"id":"771df7441c5343b4","type":"text","x":860,"y":1090,"width":565,"height":120,"text":"各向量同位删去分量后，仍线性相关"},
		{"id":"c86f6334361f98d8","type":"text","x":860,"y":1310,"width":565,"height":120,"text":"胖矩阵：$m<n$（列数多于行数） ⇒ 列向量组相关"},
		{"id":"89e69192a45a5da6","type":"text","x":1760,"y":210,"width":565,"height":120,"text":"$r(A)$ = 列向量组中极大无关组的向量数","color":"6"},
		{"id":"eac1b8e1160abef1","type":"text","x":2540,"y":210,"width":565,"height":120,"text":"极大无关组：从原组中选出，线性无关且能表示原组","color":"6"},
		{"id":"97240d3f59f6bc8f","type":"text","x":1760,"y":430,"width":565,"height":120,"text":"**列满秩：$r(A)=n$**","color":"6"},
		{"id":"ddcb45048ba48665","type":"text","x":2540,"y":430,"width":565,"height":120,"text":"**列不满秩：$r(A)<n$**","color":"6"},
		{"id":"821b8a92e510f2d7","type":"text","x":1760,"y":650,"width":565,"height":120,"text":"$S_1$ 可由 $S_2$ 线性表示"},
		{"id":"d6de0304c7a0880f","type":"text","x":2540,"y":650,"width":565,"height":120,"text":"被表示的向量组秩不大：$r(S_1)\\le r(S_2)$"},
		{"id":"b6ba3e945d98c1da","type":"text","x":1760,"y":870,"width":565,"height":120,"text":"乘积的秩：$r(AB)\\le\\min\\{r(A),r(B)\\}$"},
		{"id":"20e441d438842246","type":"text","x":3440,"y":210,"width":565,"height":120,"text":"$Ax=0$ 仅有零解 ⇔ $r(A)=n$","color":"4"},
		{"id":"4e4ad2cee02668dd","type":"text","x":4220,"y":210,"width":565,"height":120,"text":"$Ax=0$ 有非零解 ⇔ $r(A)<n$；解空间维数为 $n-r(A)$","color":"4"},
		{"id":"3bbd96e3e7e13fda","type":"text","x":4220,"y":430,"width":565,"height":120,"text":"基础解系：齐次方程组解空间的一组基"},
		{"id":"601bbdf785b9395c","type":"text","x":3440,"y":650,"width":565,"height":120,"text":"**$Ax=\\beta$ 有解**","color":"4"},
		{"id":"a32bd20710402451","type":"text","x":4220,"y":650,"width":565,"height":120,"text":"**$Ax=\\beta$ 无解**","color":"4"},
		{"id":"638752ca1879cc13","type":"text","x":3440,"y":870,"width":565,"height":120,"text":"$r(A)=r([A,\\beta])$"},
		{"id":"722eb99ebceaf370","type":"text","x":4220,"y":870,"width":565,"height":120,"text":"$r([A,\\beta])=r(A)+1$"},
		{"id":"48b120b8eee1541b","type":"text","x":3440,"y":1090,"width":565,"height":120,"text":"$\\beta$ 可由 $A$ 的列向量组线性表示"},
		{"id":"763dd2975bafd93f","type":"text","x":3440,"y":1310,"width":565,"height":120,"text":"有解且 $r(A)=n$ ⇒ 唯一解"},
		{"id":"1ee74fa800aaf0bd","type":"text","x":4220,"y":1310,"width":565,"height":120,"text":"有解且 $r(A)<n$ ⇒ 无穷多解"},
		{"id":"e6610baa42f074ab","type":"text","x":3440,"y":1530,"width":565,"height":120,"text":"同解的齐次方程组（$A,B$ 列数相同）"},
		{"id":"9f59e52506b1468e","type":"text","x":4220,"y":1530,"width":565,"height":160,"text":"$Ax=0$ 与 $Bx=0$ 同解 ⇔ $r(A)=r(B)=r\\!\\left(\\begin{bmatrix}A\\\\B\\end{bmatrix}\\right)$"},
		{"id":"14c06b3c389c55fa","type":"text","x":80,"y":2230,"width":565,"height":120,"text":"**等价向量组**","color":"3"},
		{"id":"be3395b404de826a","type":"text","x":860,"y":2230,"width":565,"height":120,"text":"两个同维向量组可互相线性表示","color":"3"},
		{"id":"0413a3720b7f2dae","type":"text","x":80,"y":2450,"width":565,"height":120,"text":"$r(S_1)=r(S_2)=r(S_1,S_2)$"},
		{"id":"50fd62276978fabc","type":"text","x":860,"y":2450,"width":565,"height":120,"text":"**矩阵等价**"},
		{"id":"c922a7e8499208aa","type":"text","x":80,"y":2670,"width":565,"height":120,"text":"两矩阵同型且 $r(A)=r(B)$"},
		{"id":"87bdd9f43e268a81","type":"text","x":860,"y":2670,"width":565,"height":120,"text":"等价的同阶方阵，特征值未必相同"},
		{"id":"5581cf486ccd6e02","type":"text","x":80,"y":2890,"width":565,"height":120,"text":"初等行变换"},
		{"id":"4b3345ed2359ea9b","type":"text","x":860,"y":2890,"width":565,"height":120,"text":"变换前后行向量组等价"},
		{"id":"bcf57d738a4c421f","type":"text","x":80,"y":3110,"width":565,"height":120,"text":"变换前后任一对应列子组的秩相同"},
		{"id":"bbc66910a3fee6c4","type":"text","x":860,"y":3110,"width":565,"height":120,"text":"列向量之间的线性相关关系保持"},
		{"id":"5c4ed28dc875c0e0","type":"text","x":1760,"y":2230,"width":565,"height":120,"text":"方阵且 $|A|\\ne0$","color":"2"},
		{"id":"6a2d75a351840019","type":"text","x":2540,"y":2230,"width":565,"height":120,"text":"方阵且 $|A|=0$","color":"2"},
		{"id":"a4c00ae50ffbdc3a","type":"text","x":1760,"y":2450,"width":565,"height":120,"text":"**$A$ 可逆**","color":"2"},
		{"id":"be3c07fa0218f199","type":"text","x":2540,"y":2450,"width":565,"height":120,"text":"**$A$ 不可逆**","color":"2"},
		{"id":"4dc59358fa7aba8b","type":"text","x":1760,"y":2670,"width":565,"height":120,"text":"$0$ 不是 $A$ 的特征值"},
		{"id":"5348faf275101a5e","type":"text","x":2540,"y":2670,"width":565,"height":120,"text":"$0$ 是 $A$ 的特征值"},
		{"id":"b8b1702e2861a6aa","type":"text","x":3440,"y":2230,"width":565,"height":160,"text":"同阶实方阵相似：$B=P^{-1}AP$（$P$ 可逆）\n相似 ⇒ 等价，反向未必","color":"1"},
		{"id":"0db207386ade265b","type":"text","x":4220,"y":2230,"width":565,"height":120,"text":"相似保持特征多项式、迹、行列式和秩","color":"1"},
		{"id":"c382bd1abd5ee07d","type":"text","x":3440,"y":2450,"width":565,"height":120,"text":"相似矩阵有相同特征值（计重数）"},
		{"id":"9e1f782e4eaa9a69","type":"text","x":4220,"y":2450,"width":565,"height":120,"text":"$n$ 阶 $A$ 有 $n$ 个线性无关的实特征向量"},
		{"id":"3df33de77adb6bcb","type":"text","x":3440,"y":2670,"width":565,"height":120,"text":"**$A$ 在实数域可相似对角化：$P^{-1}AP=\\Lambda$**","color":"1"},
		{"id":"b222088ad3139e6b","type":"text","x":4220,"y":2670,"width":565,"height":120,"text":"$P$ 的列为特征向量，$\\Lambda$ 的对角元为对应特征值；$AP=P\\Lambda$"},
		{"id":"36dc14b0fbcb938d","type":"text","x":3440,"y":2890,"width":565,"height":120,"text":"可对角化时：非零特征值数（计重数）=$r(A)$"},
		{"id":"bceb8af243c273af","type":"text","x":4220,"y":2890,"width":565,"height":160,"text":"实对称 $A$：存在正交 $Q$（$Q^{\\mathrm T}Q=I$），使 $Q^{\\mathrm T}AQ=\\Lambda$"},
		{"id":"4276217fed75a7f8","type":"text","x":3440,"y":3110,"width":565,"height":120,"text":"实对称 $A$ 经正交变换所得标准形的系数就是特征值"},
		{"id":"f3693e98fa905203","type":"text","x":4220,"y":3110,"width":565,"height":120,"text":"实对称 $A$：正特征值数（计重数）= 正惯性指数"},
		{"id":"7b995b58e508f7c7","type":"text","x":3440,"y":3330,"width":565,"height":120,"text":"实对称 $A$：负特征值数（计重数）= 负惯性指数"},
		{"id":"3b7cf36c024dad99","type":"text","x":1680,"y":-1120,"width":1500,"height":230,"text":"# 线性代数知识图谱\n设 $A\\in\\mathbb R^{m\\times n}$，$n$ 为列数。沿主线看判据，再看各模块的条件与推论。"},
		{"id":"efa81717b0ba918f","type":"text","x":490,"y":-740,"width":520,"height":130,"text":"向量组的线性关系\n线性相关 / 线性无关","color":"5"},
		{"id":"76be78605e77f77f","type":"text","x":2170,"y":-740,"width":520,"height":130,"text":"矩阵的秩与线性表示\n各类判据的枢纽","color":"6"},
		{"id":"56d2981ff2e9b01e","type":"text","x":3850,"y":-740,"width":520,"height":130,"text":"线性方程组的解\n齐次 / 非齐次","color":"4"},
		{"id":"9267b34f136ae448","type":"text","x":490,"y":-430,"width":520,"height":130,"text":"向量组等价、矩阵等价与初等变换","color":"3"},
		{"id":"41c66dcd25397164","type":"text","x":2170,"y":-430,"width":520,"height":130,"text":"方阵、行列式与可逆\n$0$ 是否为特征值","color":"2"},
		{"id":"e8479949cb1f8fdf","type":"text","x":3850,"y":-430,"width":520,"height":130,"text":"特征值、相似与二次型\n注意适用条件","color":"1"}
	],
	"edges":[
